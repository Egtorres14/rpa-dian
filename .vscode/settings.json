{
  // Intérprete del entorno virtual del proyecto (creado con: rpa instalar)
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "python.terminal.activateEnvironment": true,

  // Pruebas unitarias de la versión nueva en el panel Testing
  "python.testing.unittestEnabled": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestArgs": ["-v", "-s", "./tests", "-p", "test_*.py"],
  "python.analysis.exclude": ["**/original/**", "**/.venv/**", "**/resultados_*/**"],

  // Visores dentro de VS Code:
  //   PDF  -> tomoki1207.pdf
  //   Word, Excel y CSV -> Office Viewer (cweijan.vscode-office), en modo cuadrícula / documento
  //   Markdown y SVG siguen abriéndose como texto.
  // Para ver un CSV como texto (con colores de Rainbow CSV): clic derecho en la pestaña ->
  // "Reopen Editor With..." -> "Text Editor".
  "workbench.editorAssociations": {
    "*.pdf": "pdf.preview",
    "*.docx": "cweijan.officeViewer",
    "*.dotx": "cweijan.officeViewer",
    "*.xlsx": "cweijan.officeViewer",
    "*.xls": "cweijan.officeViewer",
    "*.xlsm": "cweijan.officeViewer",
    "*.ods": "cweijan.officeViewer",
    "*.csv": "cweijan.officeViewer",
    "*.tsv": "cweijan.officeViewer",
    "*.md": "default",
    "*.markdown": "default",
    "*.svg": "default"
  },

  // En la terminal integrada se puede escribir "rpa demo" o "rpa-original demo" sin .\
  "terminal.integrated.env.windows": {
    "PYTHONUTF8": "1",
    "PATH": "${workspaceFolder};${env:PATH}"
  },

  "files.exclude": {
    "**/__pycache__": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/resultados_*": true
  }
}
